#!/bin/sh
# OpenWrt's ntpd runs this through hotplug with ACTION (stratum, step, unsync or periodic) and
# the variable stratum. Once the clock is synchronised, the CLI tells the daemon, so its events
# carry a trusted wall clock; the daemon never asks ubus. Hotplug must never block, so every
# failure is quiet.
[ -x /usr/bin/rollcall ] || exit 0
case "$ACTION" in
step) ;;
stratum)
	case "$stratum" in
	'' | *[!0-9]*) exit 0 ;;
	esac
	[ "$stratum" -lt 16 ] || exit 0
	;;
*) exit 0 ;;
esac
/usr/bin/rollcall notify clock-synced >/dev/null 2>&1 || true
exit 0

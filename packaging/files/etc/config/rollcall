config rollcall 'main'
	# Zones peers reach rollcall in; the firewall rule opens the port to each one. A zone that
	# faces the internet (masquerading, or wan, wan6, wwan) needs static peers, and only they
	# may reach the port there.
	list peer_zone 'lan'
	# The port the daemon listens on, UDP and TCP. 7431 is taken by pmd.
	option port '7432'
	# ICMP internet probes need CAP_NET_RAW. Off by default; set to 1 to enable them.
	option icmp '0'
	# The DNS probe asks the uplink's DNS servers (from /tmp/resolv.conf.d/resolv.conf.auto) for
	# a name every 10 s, and tells when they stop answering while the internet works. On by
	# default; '0' turns it off. dns_name is the name it asks for; dns_server names the servers
	# to ask instead of the uplink's.
	# option dns_probe '1'
	# option dns_name 'openwrt.org'
	# list dns_server '192.0.2.53'
	# Static peers, for routed or NAT-separated segments: IP, IP:port or [IPv6]:port (no host
	# names). Empty means discovery only.
	# list peer '192.0.2.10:7432'
	# Quiet hours, HH:MM-HH:MM in the router's time zone (system zonename), across midnight
	# allowed: a message sent within them reaches the chat at once, with no sound. The start is
	# included, the end is not. Off unless set.
	# option quiet_hours '23:00-07:00'

#!/bin/sh
# Opens the rollcall port to each configured peer zone. The rule is rebuilt from the
# configuration every time, so running it again is harmless. With no peer zone there is
# no rule at all, rather than a rule open to every zone.
. /lib/functions.sh

ZONES=0
count_zone() { ZONES=$((ZONES + 1)); }
add_zone() { uci -q add_list firewall.rollcall.src="$1"; }

config_load rollcall
config_list_foreach main peer_zone count_zone

uci -q delete firewall.rollcall
if [ "$ZONES" -gt 0 ]; then
	uci set firewall.rollcall=rule
	uci set firewall.rollcall.name='rollcall'
	uci set firewall.rollcall.target='ACCEPT'
	uci add_list firewall.rollcall.proto='udp'
	uci add_list firewall.rollcall.proto='tcp'
	uci set firewall.rollcall.dest_port='7432'
	config_list_foreach main peer_zone add_zone
fi
uci commit firewall
exit 0

#!/bin/sh /etc/rc.common
# rollcall: watches the routers of one site and reports incidents to the chat.
# The daemon runs as its own user, with no_new_privs, a seccomp allow-list and a jail.
# It never talks to ubus: interface events arrive through hotplug and the CLI.

USE_PROCD=1
START=95
STOP=05

DAEMON=/usr/bin/rollcalld
CLI=/usr/bin/rollcall

start_service() {
	local icmp
	config_load rollcall
	config_get_bool icmp main icmp 0

	# The control socket lives in its own directory, made here as root before the jail is built.
	# The daemon runs as rollcall and creates control.sock in it, so rollcall owns it. Nobody else
	# may write to it: internal/control refuses a directory that group or others can write without
	# the sticky bit. Root, which runs the CLI from hotplug and LuCI, reaches the socket anyway.
	# The path is the constant ControlDirPath in packaging/README.md.
	mkdir -p /var/run/rollcall
	chown rollcall:rollcall /var/run/rollcall
	chmod 0700 /var/run/rollcall
	# The run-time directory (-run) is mounted into the jail too, so it must exist first.
	mkdir -p /tmp/rollcall
	chown rollcall:rollcall /tmp/rollcall
	chmod 0700 /tmp/rollcall

	procd_open_instance
	procd_set_param command "$DAEMON" -config /etc/config/rollcall -state /etc/rollcall -run /tmp/rollcall
	procd_set_param user rollcall
	procd_set_param group rollcall
	procd_set_param no_new_privs 1
	procd_set_param seccomp /etc/seccomp/rollcall.json
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# CAP_NET_RAW is granted only for ICMP probes. Without the option the daemon holds no capability.
	if [ "$icmp" = 1 ]; then
		procd_set_param capabilities /etc/capabilities/rollcall.json
	fi
	# procfs and sysfs: the daemon reads its boot ID, its own sandbox state, the routes and the
	# interface state from /proc and /sys. ronly remounts the jail's root read-only (ujail -o), so
	# only the procd_add_jail_mount_rw paths below are writable (security section 7).
	procd_add_jail rollcall log procfs sysfs ronly requirejail
	procd_add_jail_mount_rw /etc/rollcall /tmp/rollcall /var/run/rollcall
	procd_add_jail_mount /etc/config/rollcall /etc/config/firewall /etc/config/system /etc/config/network /etc/openwrt_release /etc/ssl/certs /usr/share/zoneinfo
	# DNS for api.telegram.org and probe host names. /etc/resolv.conf links to /tmp/resolv.conf,
	# which boot links to /tmp/resolv.conf.d/resolv.conf.auto and dnsmasq may replace with its own
	# file. All three are mounted read-only, so the name resolves however ujail stages the link.
	procd_add_jail_mount /etc/resolv.conf /tmp/resolv.conf /tmp/resolv.conf.d
	procd_close_instance
}

shutdown() {
	# Tell the peers this router is going down on purpose, before the instance stops.
	"$CLI" notify going-down || true
	stop
}
